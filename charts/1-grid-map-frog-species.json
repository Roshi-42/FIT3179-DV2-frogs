{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Geographic distributionn of Frog species across Australia",
  "title":{
    "text": "Where is Australia's frog distribution",
    "subtitle":"Mapped number of frog species across the nation",
    "fontSize":18,
    "subtitleFontSize":12,
    "anchor":"start",
    "color" : "#173D3B" },

    "width":"container",
    "height":450,
    "data":{"url":"data/frog_richnes.geojson","format":{"type":"json","property":"features"}},
    "projection":{"type":"mercator"},

    "mark":{"type":"geoshape","stroke":"#425E58","strokeWidth":0.15},

    "encoding":{
      "color":{"field":"properties.Sp_richnes","type":"quantitative","title":"Number of species","scale":{
        "type":"linear","domain":[1,45],"range":[
          "#E8F3DC",
          "#B7D9B0",
          "#73B69B",
          "#32877E",
          "#154C52"
        ]
      },
      "legend":{
        "orient": "right",
        "gradientLength": 250,
        "gradientThickness": 15,
        "titleFontSize": 12,
        "labelFontSize": 11,
        "format": ".0f"
      }
    },

    "tooltip":{"field":"properties.Sp_richnes","type":"quantitative","title":"mapped frogs","format":".0f"}
    }
    
    ,
    "config":{"background":"#FFFFFF","view":{"stroke":null},"font":"Arial"}

}